<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ordere_form_inherit_commission" model="ir.ui.view">
        <field name="name">sale.order.form.commission</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="card mb-3 shadow-sm" style="border-left: 5x solid #714B67">
                    <div class="card-body">
                        <h3 class="card-title text-primary">Commission Details</h3>
                        <p class="card-text">
                            <strong class="">Total Commission: </strong>
                            <field name="commission_total" wedget="monetary" options="{'currency_field': 'currency_id'}" class="fw-bold fs-4"/>
                        </p>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree_inherit_commission" model="ir.ui.view">
        <field name="name">sale.order.view.commission</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="commission_total" sum="Total Commission" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
