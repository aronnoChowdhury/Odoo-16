<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_service_device_brand_tree" model="ir.ui.view">
        <field name="name">service.device.brand.tree</field>
        <field name="model">service.device.brand</field>
        <field name="arch" type="xml">
            <tree string="Device Brands">
                <field name="name" /> 
                <field name="code" />
                <field name="model_count" /> 
                <field name="active" widget="boolean_toggle" />
            </tree>
        </field>
    </record> 

    <record id="view_service_device_brand_form" model="ir.ui.view">
        <field name="name">service.device.brand.form</field>
        <field name="model">service.device.brand</field>
        <field name="arch" type="xml">
            <form string="Device Brand">
                <sheet> 
                    <field name="logo" widget="image" class="oe_avatar" /> 
                    <div class="oe_title"> 
                        <label for="name" class="oe_edit_only" string="Brand Name"/> 
                        <h1 class=""><field name="name" placeholder="e.g. Apple, Samsung, Dell" /></h1>
                    </div>
                    <group>
                        <group> 
                            <field name="code" placeholder="e.g APL, SAM" />
                        </group> 
                        <group>
                            <field name="active" widget="boolean_toggle" /> 
                            <field name="model_count" />
                        </group>
                    </group> 
                    <notebook>
                        <page name="" string="Models Under this Brand">
                            <field name="model_ids"> 
                                <tree editable="bottom"> 
                                    <field name="name" /> 
                                    <field name="device_type" /> 
                                    <field name="default_warranty_months" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record> 

    <record id="action_service_device_brand" model="ir.actions.act_window">
        <field name="name">Device Brands</field>
        <field name="res_model">service.device.brand</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first device brand (e.g Apple, Samsung, Hp)
            </p>
        </field>
    </record>

</odoo>
