<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_service_order_tree" model="ir.ui.view">
        <field name="name">service.order.tree</field>
        <field name="model">service.order</field>
        <field name="arch" type="xml">
            <tree string="Service Orders" sample="1" decoration-info="state == 'draft'" decoration-warning="state in ('diagnosing', 'quotation')" decoration-primary="state == in_progress" decoration-success="state in ('ready', 'delivered')">
                <field name="name" string="Job Sheet No" decoration-bf="1" /> 
                <field name="data-received" /> 
                <field name="partner_id" /> 
                <field name="brand_id" /> 
                <field name="model_id" /> 
                <field name="serial_no" optional="show" /> 
                <field name="technician_id" widget="many2one_avatar_user" optional="show" /> 
                <field name="date_deadline" widget="remaining_days" optional="show" /> 
                <field name="priority" widget="priority" optional="show" /> 
                <field name="amount_total" sum="Total Revenue" widget="monetary" decoration-bf="1" /> 
                <field name="currency_id" invisible="1" /> 
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-warning="state in ('diagnosing', 'quotation')" 
                       decoration-primary="state == 'in_progress'" 
                       decoration-success="state in ('ready', 'delivered')"
                       decoration-danger="state == 'cancelled'"/> 
            </tree>
        </field>
    </record>

</odoo>
