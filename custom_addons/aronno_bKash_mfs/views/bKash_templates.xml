<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="bkash_dashboard_template" name="bKash Dashboard">
    <t t-call="website.layout">
        <t t-set="no_header" t-value="True"/>
        <t t-set="no_footer" t-value="True"/>
        <div class="oe_structure py-5" id="wrap" style="background-color: #f4f5f7; min-height: 100vh;">
            <div class="container">
                <div class="bkash-container mx-auto shadow" style="max-width: 450px; background: #ffffff; border-radius: 20px; overflow: hidden;">
                    <t t-call="aronno_bKash_mfs.bkash_custom_header"/>

                    <style>
                        .real-balance { display: none; }
                        .masked-balance { display: inline; }

                        #balance-toggle:checked ~ .balance-content .real-balance { display: inline; }
                        #balance-toggle:checked ~ .balance-content .masked-balance { display: none; }
                        #balance-toggle:checked ~ .balance-btn-label {
                            background-color: #e2136e !important;
                            color: #fff !important;
                        }
                    </style>

                    <div class="balance-card d-flex justify-content-between align-items-center bg-white rounded shadow-sm p-3 mx-3 my-3"  style="border-left: 5px solid #e2136e; position: relative;">
                        <input type="checkbox" id="balance-toggle" class="d-none"/>

                        <div class="balance-content">
                            <span class="text-muted" style="font-size: 12px;">Total Balance</span>
                            <h4 class="mb-0 fw-bold text-dark">
                                 <span class="masked-balance">৳ *******</span>
                                 <span class="real-balance">৳ 12,500.00</span> 
                            </h4>
                        </div>
                        <label for="balance-toggle" class="balance-btn-label btn btn-sm rounded-pill mb-0 fw-bold px-3" style="border: 1px solid #e2136e; color: #e2136e; background-color: #fdf0f5; font-size: 11px; cursor: pointer;">Tap to Balance</label>
                    </div>

                    <div class="container px-4 my-4">
                        <div class="row g-3 text-center">
                            <div class="col-4">
                                <a href="/bkash/send-money" class="text-decoration-none">
                                    <div class="service-icon mx-auto d-flex justify-content-center align-items-center rounded-circle shadow-sm" style="background: #fdf0f5; width: 55px; height: 55px; font-size: 18px; cursor: pointer;">📤</div>
                                    <div class="service-level mt-2" style="font-size: 12px; font-weight: 600; color: #444;">Send Money</div>
                                </a>
                            </div>
                            <div class="col-4">
                                <a href="/bkash/cash-out" class="text-decoration-none">
                                    <div class="service-icon mx-auto d-flex justify-content-center align-items-center rounded-circle shadow-sm" style="background: #fdf0f5; width: 55px; height: 55px; font-size: 18px; cursor: pointer;">💸</div>
                                    <div class="service-level mt-2" style="font-size: 12px; font-weight: 600; color: #444;">Cash Out</div>
                                </a>
                            </div>
                            <div class="col-4">
                                <a href="/bkash/recharge" class="text-decoration-none">
                                    <div class="service-icon mx-auto d-flex justify-content-center align-items-center rounded-circle shadow-sm" style="background: #fdf0f5; width: 55px; height: 55px; font-size: 18px; cursor: pointer;">📱</div>
                                    <div class="service-level mt-2" style="font-size: 12px; font-weight: 600; color: #444;">Recharge</div>
                                </a>
                            </div>
                        </div>
                    </div>
                    
                    <t t-call="aronno_bKash_mfs.bkash_custom_footer"/>
                </div>
            </div>
        </div>
    </t>
</template>
</odoo>