<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="bkash_dashboard_template" name="bKash Dashboard">
        <t t-call="website.layout">
            <div class="oe_structure" id="wrap">
                <div class="container my-5">
                    <div class="bkash_container pb-4 mx-auto" style="max-width: 450px; background: #ffffff; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); overflow: hidden;">
                        <div class="bkash-header text-center text-white p-4" style="background-color: #e2136e;">
                            <h5 class="mb-1">bKash Web</h5>
                            <small class="">Aronno Chowdhury</small>
                        </div>

                        <div class="balance-card d-flex justify-content-between align-items-center bg-white p-3 mx-3 mt-n3 shadow-sm rounded" style="border-left: 5px solid #e2136e; position: relative;">
                            <div class="">
                                <span class="text-muted" style="font-size: 12px;">Total Balance</span>
                                <h4 class="mb-0 fw-bold text-dark">৳ 12,500.00</h4>
                            </div>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3">Tap to Balance</button>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
