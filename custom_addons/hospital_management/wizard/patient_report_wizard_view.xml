<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_patient_report_wizard_form" model="ir.ui.view">
        <field name="name">patient.report.wizard.form</field>
        <field name="model">patient.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Patient Report">
                <group>
                    <group>
                        <field name="patient_id" placeholder="Select specific patient (Leave empty for all)"/>
                        <field name="status" widget="radio"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="Print Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_patient_report_wizard" model="ir.actions.act_window">
        <field name="name">Patient Report</field>
        <field name="res_model">patient.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
