<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_dashboard_patient_graph" model="ir.actions.act_window">
        <field name="name">Patient Status</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="hospital_management.view_hospital_patient_graph"/>
    </record>

    <record id="action_dashboard_patient_list" model="ir.actions.act_window">
        <field name="name">Registered Patients</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="hospital_management.view_hospital_patient_tree"/>
    </record>

    <record id="action_dashboard_appointment_calendar" model="ir.actions.act_window">
        <field name="name">Appointments Calendar</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="hospital_management.view_hospital_appointment_calendar"/>
    </record>

    <record id="action_dashboard_appointment_graph" model="ir.actions.act_window">
        <field name="name">Weekly Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="hospital_management.view_hospital_appointment_graph"/>
    </record>

    <record id="action_dashboard_pharmacy_graph" model="ir.actions.act_window">
        <field name="name">Top Consumables</field>
        <field name="res_model">hospital.pharmacy</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="hospital_management.view_hospital_pharmacy_graph"/>
    </record>

    <record id="action_dashboard_pharmacy_alerts" model="ir.actions.act_window">
        <field name="name">Critical Alerts</field>
        <field name="res_model">hospital.pharmacy</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="hospital_management.view_hospital_pharmacy_tree"/>
        <field name="domain">[('stock_qty', '&lt;=', 50)]</field>
    </record>

    <record id="action_dashboard_accounting_graph" model="ir.actions.act_window">
        <field name="name">Monthly Value Trends</field>
        <field name="res_model">hospital.accounting</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="hospital_management.view_hospital_accounting_graph"/>
    </record>

    <record id="board_hospital_dashboard_view" model="ir.ui.view">
        <field name="name">Hospital Dashboard</field>
        <field name="model">board.board</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Hospital Dashboard">
                <board style="1-1-1">
                    <column>
                        <action name="%(action_dashboard_patient_graph)d" string="Patient Status"/>
                        <action name="%(action_dashboard_patient_list)d" string="Patient Registration"/>
                    </column>
                    <column>
                        <action name="%(action_dashboard_appointment_calendar)d" string="Doctor Appointments"/>
                        <action name="%(action_dashboard_appointment_graph)d" string="Weekly Appointments"/>
                    </column>
                    <column>
                        <action name="%(action_dashboard_pharmacy_graph)d" string="Top Consumables"/>
                        <action name="%(action_dashboard_pharmacy_alerts)d" string="Critical Alerts"/>
                        <action name="%(action_dashboard_accounting_graph)d" string="Monthly Value Trends"/>
                    </column>
                </board>
            </form>
        </field>
    </record>

    <record id="open_board_hospital_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">board.board</field>
        <field name="view_mode">form</field>
        <field name="usage">menu</field>
        <field name="view_id" ref="board_hospital_dashboard_view"/>
    </record>

</odoo>
