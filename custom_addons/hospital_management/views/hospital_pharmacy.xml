<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_pharmacy_tree" model="ir.ui.view">
        <field name="name">hospital.pharmacy.tree</field>
        <field name="model">hospital.pharmacy</field>
        <field name="arch" type="xml">
            <tree string="Pharmacy Inventory">
                <field name="medicine_name" />
                <field name="category" />
                <field name="stock_qty" />
                <field name="reorder_point" />
                <field name="unit_price" />
                <field name="status" widget="badge" />
            </tree>
        </field>
    </record>

    <record id="view_hospital_pharmacy_form" model="ir.ui.view">
        <field name="name">hospital.pharmacy.form</field>
        <field name="model">hospital.pharmacy</field>
        <field name="arch" type="xml">
            <form string="Pharmacy Inventory">
                <sheet>
                    <group>
                        <group>
                            <field name="medicine_name"/>
                            <field name="category"/>
                            <field name="unit_price"/>
                        </group>
                        <group>
                            <field name="stock_qty"/>
                            <field name="reorder_point"/>
                            <field name="status" widget="badge"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_pharmacy_kanban" model="ir.ui.view">
        <field name="name">hospital.pharmacy.kanban</field>
        <field name="model">hospital.pharmacy</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" sample="1">
                <field name="id"/>
                <field name="medicine_name"/>
                <field name="category"/>
                <field name="stock_qty"/>
                <field name="unit_price"/>
                <field name="status"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_res_partner_kanban">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="medicine_name"/>
                                </strong>
                                <div class="mt-1">
                                    <span>Category: <field name="category"/></span>
                                </div>
                                <div>
                                    <span>Current Stock: <field name="stock_qty"/></span>
                                </div>
                                <div>
                                    <span>Price: <field name="unit_price" widget="monetary"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hospital_pharmacy_graph" model="ir.ui.view">
        <field name="name">hospital.pharmacy.graph</field>
        <field name="model">hospital.pharmacy</field>
        <field name="arch" type="xml">
            <graph string="Top 5 Consumables" type="bar" sample="1">
                <field name="medicine_name"/>
                <field name="stock_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_hospital_pharmacy" model="ir.actions.act_window">
        <field name="name">Pharmacy</field>
        <field name="res_model">hospital.pharmacy</field>
        <field name="view_mode">tree,kanban,graph,form</field>
        <field name="type">ir.actions.act_window</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first medicine to the pharmacy inventory!
            </p>
        </field>
    </record>

</odoo>
