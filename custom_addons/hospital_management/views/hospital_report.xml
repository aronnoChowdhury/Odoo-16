<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_patient_card" model="ir.actions.report">
        <field name="name">Report Card</field>
        <field name="model">hospital.patient</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_management.report_patient_card_template</field>
        <field name="report_file">hospital_management.report_patient_card_template</field>
        <field name="binding_model_id" ref="model_hospital_patient" />
        <field name="binding_type">report</field>
    </record>
    
    
    <template id="report_patient_card_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="">Hospital Patient Information Card</h2>
                        <div class="row mt-32 mb-32">
                            <div class="col-6">
                                <strong class="">Patient ID:</strong><span t-field="o.patient_id"/><br class=""/>
                                <strong class="">Full Name:</strong><span t-field="o.full_name"/><br class=""/>
                                <strong class="">Contact Number:</strong><span t-field="o.contact_number"/><br class=""/>
                            </div>
                            <div class="col-6">
                                <strong class="">Status:</strong><span t-field="o.status"/><br class=""/>
                                <strong class="">Last Visit Date:</strong><span t-field="o.last_visit_date"/><br class=""/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>



</odoo>
