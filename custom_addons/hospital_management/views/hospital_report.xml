<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_patient_card" model="ir.actions.report">
        <field name="name">Report Card</field>
        <field name="model">hospital.patient</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_management.report_patient_card_template</field>
        <field name="report_file">hospital_management.report_patient_card_template</field>
        <field name="binding_model_id" ref="model_hospital_patient" />
        <field name="binding_type">report</field>
    </record>
    
    <template id="report_patient_card_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="company" t-value="res_company if res_company else o.env.company"/>
                    <t t-set="bills" t-value="o.env['hospital.accounting'].search([('patient_id', '=', o.id)])"/>
                    <t t-set="appointments" t-value="o.env['hospital.appointment'].search([('patient_id', '=', o.id)])"/>
                    <t t-set="lab_tests" t-value="o.env['hospital.lab'].search([('patient_id', '=', o.id)])"/>

                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; color: #2d3748;">
                        
                        <div class="row pb-3 mb-3" style="border-bottom: 3px solid #1e1b2e;">
                            <div class="col-3 text-start">
                                <t t-if="company and company.logo">
                                    <img t-att-src="image_data_uri(company.logo)" style="max-height: 80px; max-width: 170px;" alt="Hospital Logo"/>
                                </t>
                                <t t-else="">
                                    <div style="width: 70px; height: 70px; background: #1e1b2e; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center;">
                                        <svg width="48" height="48" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <rect width="100" height="100" rx="16" fill="#1e1b2e"/>
                                            <path d="M40 20H60V40H80V60H60V80H40V60H20V40H40V20Z" fill="#2563eb"/>
                                            <path d="M44 24H56V44H76V56H56V76H44V56H24V44H44V24Z" fill="#ffffff"/>
                                        </svg>
                                    </div>
                                </t>
                            </div>
                            <div class="col-6 text-center">
                                <h3 style="font-weight: 800; color: #1e1b2e; margin: 0; letter-spacing: 0.5px; text-transform: uppercase;">
                                    <span class="">MY ODOO HOSPITAL</span>
                                </h3>
                                <p style="margin: 3px 0 0 0; color: #4a5568; font-weight: 600; font-size: 12px;">
                                    Healthcare &amp; Clinical Management Center
                                </p>
                                <small style="color: #718096; font-size: 11px;">
                                    <span t-if="company and company.phone">Tel: <t t-esc="company.phone"/> | </span>
                                    <span t-if="company and company.email">Email: <t t-esc="company.email"/> | </span>
                                    <span t-if="company and company.website"><t t-esc="company.website"/></span>
                                </small>
                            </div>
                            <div class="col-3 text-end">
                                <div style="background-color: #2563eb; color: #ffffff; padding: 6px 12px; border-radius: 6px; font-weight: bold; font-size: 12px; display: inline-block;">
                                    PATIENT REPORT CARD
                                </div>
                                <div class="mt-2 text-muted" style="font-size: 11px;">
                                    <strong>Date:</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%b-%Y')"/>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4" style="border: 1px solid #cbd5e1; border-radius: 8px; overflow: hidden;">
                            <div style="background-color: #1e1b2e; color: #ffffff; padding: 8px 15px; font-weight: bold; font-size: 13px;">
                                👤 Patient Profile
                            </div>
                            <div style="padding: 12px 15px; background-color: #f8fafc;">
                                <div class="row">
                                    <div class="col-6">
                                        <table class="table table-borderless table-sm mb-0">
                                            <tr>
                                                <td style="width: 40%; color: #64748b; font-weight: 600;">Patient ID:</td>
                                                <td style="font-weight: bold; color: #1e1b2e;">
                                                    <span t-field="o.patient_id"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="color: #64748b; font-weight: 600;">Full Name:</td>
                                                <td style="font-weight: bold; font-size: 14px; color: #0f172a;">
                                                    <span t-field="o.full_name"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="color: #64748b; font-weight: 600;">Contact Number:</td>
                                                <td><span t-field="o.contact_number"/></td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="col-6">
                                        <table class="table table-borderless table-sm mb-0">
                                            <tr>
                                                <td style="width: 40%; color: #64748b; font-weight: 600;">Status:</td>
                                                <td>
                                                    <span t-if="o.status == 'inpatient'" style="background-color: #ef4444; color: white; padding: 3px 10px; border-radius: 12px; font-weight: 600; font-size: 11px;">Inpatient</span>
                                                    <span t-elif="o.status == 'outpatient'" style="background-color: #2563eb; color: white; padding: 3px 10px; border-radius: 12px; font-weight: 600; font-size: 11px;">Outpatient</span>
                                                    <span t-else="" style="background-color: #10b981; color: white; padding: 3px 10px; border-radius: 12px; font-weight: 600; font-size: 11px;">Discharged</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="color: #64748b; font-weight: 600;">Last Visit Date:</td>
                                                <td><span t-field="o.last_visit_date"/></td>
                                            </tr>
                                            <tr>
                                                <td style="color: #64748b; font-weight: 600;">Next Appointment:</td>
                                                <td>
                                                    <span t-if="o.next_appointment" t-field="o.next_appointment"/>
                                                    <span t-else="" class="text-muted">Not Scheduled</span>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        
                        <div class="mb-4" style="border: 1px solid #cbd5e1; border-radius: 8px; overflow: hidden;">
                            <div style="background-color: #1e1b2e; color: #ffffff; padding: 8px 15px; font-weight: bold; font-size: 13px;">
                                💳 Billing &amp; Financial Summary
                            </div>
                            <div style="padding: 12px 15px;">
                                <table class="table table-sm table-bordered text-center align-middle mb-2" style="border-color: #e2e8f0; font-size: 12px;">
                                    <thead style="background-color: #f1f5f9; color: #334155; font-weight: 700;">
                                        <tr>
                                            <th>Bill Ref</th>
                                            <th>Doctor Fee</th>
                                            <th>Medicine Fee</th>
                                            <th>Lab Fee</th>
                                            <th>Total Amount</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="bills">
                                            <tr t-foreach="bills" t-as="b">
                                                <td style="font-weight: 600;"><span t-field="b.name"/></td>
                                                <td><span t-field="b.doctor_fee" t-options='{"widget": "monetary", "display_currency": (company and company.currency_id) or o.env.company.currency_id}'/></td>
                                                <td><span t-field="b.medicine_fee" t-options='{"widget": "monetary", "display_currency": (company and company.currency_id) or o.env.company.currency_id}'/></td>
                                                <td><span t-field="b.lab_fee" t-options='{"widget": "monetary", "display_currency": (company and company.currency_id) or o.env.company.currency_id}'/></td>
                                                <td style="font-weight: bold; color: #2563eb;">
                                                    <span t-field="b.total_amount" t-options='{"widget": "monetary", "display_currency": (company and company.currency_id) or o.env.company.currency_id}'/>
                                                </td>
                                                <td>
                                                    <span t-if="b.state == 'paid'" style="background-color: #dcfce7; color: #166534; padding: 2px 8px; border-radius: 10px; font-weight: 600; font-size: 11px;">Paid</span>
                                                    <span t-elif="b.state == 'draft'" style="background-color: #fef9c3; color: #854d0e; padding: 2px 8px; border-radius: 10px; font-weight: 600; font-size: 11px;">Draft</span>
                                                    <span t-else="" style="background-color: #fee2e2; color: #991b1b; padding: 2px 8px; border-radius: 10px; font-weight: 600; font-size: 11px;">Cancelled</span>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            <tr>
                                                <td colspan="6" class="text-muted py-3">No billing records found for this patient.</td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>

        
                                <t t-set="total_doc" t-value="sum(b.doctor_fee for b in bills)"/>
                                <t t-set="total_med" t-value="sum(b.medicine_fee for b in bills)"/>
                                <t t-set="total_lab" t-value="sum(b.lab_fee for b in bills)"/>
                                <t t-set="grand_total" t-value="sum(b.total_amount for b in bills)"/>
                                <t t-set="paid_total" t-value="sum(b.total_amount for b in bills if b.state == 'paid')"/>
                                <t t-set="due_total" t-value="grand_total - paid_total"/>

                                <div class="row justify-content-end mt-3">
                                    <div class="col-6">
                                        <table class="table table-sm table-bordered mb-0" style="border-color: #cbd5e1; font-size: 12px;">
                                            <tr>
                                                <td style="background-color: #f8fafc; font-weight: 600;">Total Doctor Fees:</td>
                                                <td class="text-end"><t t-esc="'%.2f' % total_doc"/></td>
                                            </tr>
                                            <tr>
                                                <td style="background-color: #f8fafc; font-weight: 600;">Total Medicine Fees:</td>
                                                <td class="text-end"><t t-esc="'%.2f' % total_med"/></td>
                                            </tr>
                                            <tr>
                                                <td style="background-color: #f8fafc; font-weight: 600;">Total Lab Fees:</td>
                                                <td class="text-end"><t t-esc="'%.2f' % total_lab"/></td>
                                            </tr>
                                            <tr style="background-color: #1e1b2e; color: #ffffff; font-weight: bold; font-size: 13px;">
                                                <td>TOTAL BILL AMOUNT:</td>
                                                <td class="text-end" style="color: #60a5fa;"><t t-esc="'%.2f' % grand_total"/></td>
                                            </tr>
                                            <tr>
                                                <td style="background-color: #f8fafc; font-weight: 600; color: #166534;">Total Paid:</td>
                                                <td class="text-end" style="color: #166534; font-weight: bold;"><t t-esc="'%.2f' % paid_total"/></td>
                                            </tr>
                                            <tr>
                                                <td style="background-color: #f8fafc; font-weight: 600; color: #dc2626;">Balance Due:</td>
                                                <td class="text-end" style="color: #dc2626; font-weight: bold;"><t t-esc="'%.2f' % due_total"/></td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                    
                        <div class="row mb-4">
                            <div class="col-6">
                                <div style="border: 1px solid #cbd5e1; border-radius: 8px; overflow: hidden; height: 100%;">
                                    <div style="background-color: #334155; color: #ffffff; padding: 6px 12px; font-weight: bold; font-size: 12px;">
                                        🩺 Appointments
                                    </div>
                                    <div style="padding: 8px 12px;">
                                        <table class="table table-sm table-bordered mb-0" style="font-size: 11px;">
                                            <thead style="background-color: #f8fafc;">
                                                <tr>
                                                    <th>Doctor</th>
                                                    <th>Date</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-if="appointments">
                                                    <tr t-foreach="appointments" t-as="app">
                                                        <td><span t-field="app.doctor_id.name"/></td>
                                                        <td><span t-field="app.appointment_date"/></td>
                                                        <td><span t-field="app.state"/></td>
                                                    </tr>
                                                </t>
                                                <t t-else="">
                                                    <tr>
                                                        <td colspan="3" class="text-muted text-center py-2">No appointments scheduled.</td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

        
                            <div class="col-6">
                                <div style="border: 1px solid #cbd5e1; border-radius: 8px; overflow: hidden; height: 100%;">
                                    <div style="background-color: #334155; color: #ffffff; padding: 6px 12px; font-weight: bold; font-size: 12px;">
                                        🧪 Laboratory Tests
                                    </div>
                                    <div style="padding: 8px 12px;">
                                        <table class="table table-sm table-bordered mb-0" style="font-size: 11px;">
                                            <thead style="background-color: #f8fafc;">
                                                <tr>
                                                    <th>Test Name</th>
                                                    <th>Date</th>
                                                    <th>Result / Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-if="lab_tests">
                                                    <tr t-foreach="lab_tests" t-as="lab">
                                                        <td style="font-weight: 600;"><span t-field="lab.test_name"/></td>
                                                        <td><span t-field="lab.test_date"/></td>
                                                        <td>
                                                            <span t-if="lab.result_summary" t-field="lab.result_summary"/>
                                                            <span t-else="" t-field="lab.state"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                                <t t-else="">
                                                    <tr>
                                                        <td colspan="3" class="text-muted text-center py-2">No lab tests conducted.</td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row pt-4 mt-4" style="border-top: 1px dashed #cbd5e1;">
                            <div class="col-6 text-center">
                                <div style="width: 180px; border-bottom: 1px solid #000; margin: 35px auto 5px auto;"></div>
                                <strong style="color: #475569; font-size: 11px;">Hospital Authority / Accounts</strong>
                            </div>
                            <div class="col-6 text-center">
                                <div style="width: 180px; border-bottom: 1px solid #000; margin: 35px auto 5px auto;"></div>
                                <strong style="color: #475569; font-size: 11px;">Consultant / Doctor Signature</strong>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
