<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_accounting_tree" model="ir.ui.view">
        <field name="name">hospital.accounting.tree</field>
        <field name="model">hospital.accounting</field>
        <field name="arch" type="xml">
            <tree string="Hospital Accountings">
                <field name="name" />
                <field name="patient_id" />
                <field name="total_amount" sum="Total Revenue" />
                <field name="state" widget="badge" />
            </tree>
        </field>
    </record>

    <record id="view_hospital_accounting_form" model="ir.ui.view">
        <field name="name">hospital.accounting.form</field>
        <field name="model">hospital.accounting</field>
        <field name="arch" type="xml">
            <form string="Hospital Accounting">
                <sheet>
                    <div class="oe_title">
                        <h1 class=""><field name="name" readonly="1" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id" />
                            <field name="doctor_fee" />
                        </group>
                        <group>
                            <field name="medicine_fee" />
                            <field name="lab_fee" />
                            <field name="total_amount" />
                            <field name="state" widget="badge" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_accounting_kanban" model="ir.ui.view">
        <field name="name">hospital.accounting.kanban</field>
        <field name="model">hospital.accounting</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="total_amount"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_res_partner_kanban">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-1">
                                    <span>Patient: <field name="patient_id"/></span>
                                </div>
                                  <div>
                                      <span>Total: <field name="total_amount"/></span>
                                  </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hospital_accounting_graph" model="ir.ui.view">
        <field name="name">hospital.accounting.graph</field>
        <field name="model">hospital.accounting</field>
        <field name="arch" type="xml">
            <graph string="Total Revenue" type="line" sample="1">
                <field name="patient_id"/>
                <field name="total_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_hospital_accounting" model="ir.actions.act_window">
        <field name="name">Accounting &amp; Billing</field>
        <field name="res_model">hospital.accounting</field>
        <field name="view_mode">tree,kanban,graph,form</field>
        <field name="type">ir.actions.act_window</field>
    </record>

</odoo>
