<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_lab_tree" model="ir.ui.view">
        <field name="name">hospital.lab.tree</field>
        <field name="model">hospital.lab</field>
        <field name="arch" type="xml">
            <tree string="Lab Tests">
                <field name="patient_id"/>
                <field name="test_name"/>
                <field name="test_date"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_hospital_lab_form" model="ir.ui.view">
        <field name="name">hospital.lab.form</field>
        <field name="model">hospital.lab</field>
        <field name="arch" type="xml">
            <form string="Lab Tests">
                <sheet>
                    <group>
                        <group name="" string="">
                            <field name="patient_id" />
                            <field name="test_name" />
                        </group>
                        <group>
                            <field name="test_date" />
                            <field name="state" widget="badge" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Result Summary">
                            <field name="result_summary" placeholder="Enter diagnostic test results here..." />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_lab_kanban" model="ir.ui.view">
        <field name="name">hospital.lab.kanban</field>
        <field name="model">hospital.lab</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="id"/>
                <field name="patient_id"/>
                <field name="test_name"/>
                <field name="test_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_res_partner_kanban">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    Patient: <field name="patient_id"/>
                                </strong>
                                <div class="mt-1">
                                    <span>Test: <field name="test_name"/></span>
                                </div>
                                <div>
                                    <span>Date: <field name="test_date"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hospital_lab" model="ir.actions.act_window">
        <field name="name">Lab Tests</field>
        <field name="res_model">hospital.lab</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="type">ir.actions.act_window</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new diagnostic test record for a patient!
            </p>
        </field>
    </record>

</odoo>
