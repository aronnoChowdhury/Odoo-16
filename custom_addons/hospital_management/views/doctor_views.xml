<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_doctor_tree" model="ir.ui.view">
        <field name="name">hospital.doctor.tree</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <tree string="Doctors">
                <field name="name" />
                <field name="specialization" />
                <field name="phone" />
                <field name="available_time" />
            </tree>
        </field>
    </record>

    <record id="view_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hospital.doctor.form</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <form string="Doctors">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="specialization" />
                        <field name="phone" />
                        <field name="available_time" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_doctor_kanban" model="ir.ui.view">
        <field name="name">hospital.doctor.kanban</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <kanban default_group_by="specialization" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="specialization"/>
                <field name="phone"/>
                <field name="available_time"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_res_partner_kanban">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-1">
                                    <span>Specialization: <field name="specialization"/></span>
                                </div>
                                <div>
                                    <span>Phone: <field name="phone"/></span>
                                </div>
                                <div>
                                    <span>Hours: <field name="available_time"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hospital_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="type">ir.actions.act_window</field>
    </record>

</odoo>
