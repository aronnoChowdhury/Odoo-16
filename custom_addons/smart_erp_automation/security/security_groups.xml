<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_smart_erp" model="ir.module.category">
        <field name="name">Smart ERP AI</field>
        <field name="description">Access management for Smart ERP AI Automation</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_smart_erp_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_smart_erp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_smart_erp_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_smart_erp" />
        <field name="implied_ids" eval="[(4, ref('group_smart_erp_user'))]" />
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>

</odoo>
