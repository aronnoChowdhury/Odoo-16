<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="pro_client_portal_page" name="Professional Client Portal">
        <t t-call="website.layout">
            <div id="wrap" class="bg-light min-vh-100 py-5">
                <div class="container mb-5">
                    <div class="pro-dashboard-header p-5 shadow-lg">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h1 class="fw-bold mb-2">Welcome Back, <t t-esc="env.user.partner_id.name"/>!</h1>
                                <p class="lead opacity-75 mb-0"><t t-esc="message"/></p>
                            </div>
                            <div class="col-md-4 text-md-end d-none d-md-block opacity-25">
                                <i class="fa fa-user-circle fa-5x"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="container py-2">
                    <div class="row g-4">
                        <div class="col-md-4 flex-stretch">
                            <a href="/my_portal/projects" class="text-decoration-none">
                            <div class="card pro-card pro-card-project p-4 h-100">
                                <div class="pro-card-content d-flex flex-column justify-content-between h-100">
                                    <div class="text-center">
                                        <h5 class="opacity-90 fw-semibold text-uppercase tracking-wider">Active Projects</h5>
                                        <h1 class="fw-bold display-5 my-3 text-light"><t t-esc="active_projects or '0'"/></h1>
                                    </div>
                                    <p class="mb-0 opacity-75 small text-light"><t t-esc="project_text"/></p>
                                </div>
                                <i class="fa fa-briefcase pro-icon-bg"></i>
                            </div>
                            </a>
                        </div>
                        <div class="col-md-4 flex-stretch">
                            <a href="/my_portal/tasks" class="text-decoration-none">
                            <div class="card pro-card pro-card-tasks p-4 h-100">
                                <div class="pro-card-content d-flex flex-column justify-content-between h-100">
                                    <div class="text-center">
                                        <h5 class="opacity-90 fw-semibold text-uppercase tracking-wider">Pending Tasks</h5>
                                        <h1 class="fw-bold display-5 my-3 text-light"><t t-esc="pending_tasks or '0'"/></h1>
                                    </div>
                                    <p class="mb-0 opacity-75 small text-light"><t t-esc="tasks_text"/></p>
                                </div>
                                <i class="fa fa-tasks pro-icon-bg"></i>
                            </div>
                            </a>
                        </div>
                        <div class="col-md-4 flex-stretch">
                            <a href="/my_portal/invoices" class="text-decoration-none">
                            <div class="card pro-card pro-card-invoices p-4 h-100">
                                <div class="pro-card-content d-flex flex-column justify-content-between h-100">
                                    <div class="text-center">
                                        <h5 class="opacity-90 fw-semibold text-uppercase tracking-wider">Total Invoices</h5>
                                        <h1 class="fw-bold display-5 my-3 text-light"><t t-esc="total_invoices or '$0.00'"/></h1>
                                    </div>
                                    <t t-if="show_no_invoices">
                                        <p class="mb-0 opacity-75 small text-light">No invoices found for your account.</p>
                                    </t>
                                    <t t-else="">
                                        <p class="mb-0 opacity-75 small text-light">Click to view all billing details.</p>
                                    </t>
                                </div>
                                <i class="fa fa-credit-card pro-icon-bg"></i>
                            </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="pro_client_portal_projects_page" name="Project Page">
        <t t-call="website.layout">
            <div class="bg-light min-vh-100 py-5" id="wrap">
                <div class="container">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="text-dark m-0 fw-bold">My Projects</h2>
                        <a href="/my_portal" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
                            <i class="fa fa-arrow-left me-1"></i>Back to Dashboard
                        </a>
                    </div>

                    <div class="row g-4" t-if="projects">
                        <t t-foreach="projects" t-as="project">
                            <div class="col-md-6 col-lg-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h4 class="fw-bold text-dark mb-0 text-truncate"><t t-esc="project.name"/></h4>
                                </div>
                                <div class="text-muted small mb-3">
                                    <i class="fa fa-user me-2"></i>Project Manager:
                                    <span class="fw-semibold" t-esc="project.user_id.name or 'N/A'" ></span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top border-light">
                                    <span class="badge bg-light text-dark fw-semibold py-1.5 px-3 rounded-pill">
                                        <t t-esc="len(project.task_ids)"/> Tasks
                                    </span>
                                    <a href="/my_portal/tasks" class="btn btn-link p-0 fw-bold text-primary">View Tasks</a>
                                </div>
                            </div>
                        </t>
                    </div>
                    <div class="text-center py-5 shadow-sm bg-white rounded-3 mt-4" t-else="">
                        <div class="text-muted mb-3"><i class="fa fa-briefcase fa-4x opacity-50"></i></div>
                        <h4 class="fw-bold text-dark">No Projects Found</h4>
                        <p class="text-muted mb-0">You don't have any active projects assigned at the moment.</p>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="pro_client_portal_tasks_page" name="Portal Tasks">
        <t t-call="website.layout">
            <div class="wrap bg-light py-5 min-vh-100">
                <div class="container">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="fw-bold text-dark m-0">My Tasks</h2>
                        <a href="/my_portal" class="btn btn-outline-secondary rounded-pill px-3 py-1.5 btn-sm">
                            <i class="fa fa-arrow-left me-1"></i>Back to Dashboard
                        </a>
                    </div>
                    <div class="card shadow-sm border-0 rounded-3 overflow-hidden" t-if="tasks">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 custom-portal-table">
                                <thead class="table-dark">
                                    <tr class="">
                                        <th class="ps-4 py-3">Task Name</th>
                                        <th class="ps-4 py-3">Associated Project</th>
                                        <th class="ps-4 py-3">Deadline</th>
                                        <th class="ps-4 py-3">Stage/Status</th>
                                    </tr>
                                </thead>
                                <tbody class="">
                                    <t t-foreach="tasks" t-as="task">
                                        <tr class="">
                                            <td class="ps-4 fw-bold text-dark py-3" t-esc="task.name"/>
                                            <td class="text-muted py-3" t-esc="task.project_id.name or 'N/A'"/>
                                            <td class="text-muted py-3">
                                                <span class="" t-if="task.date_deadline">
                                                    <i class="fa fa-calendar-o me-2"></i>
                                                    <t t-esc="task.date_deadline" t-options="{'widget': 'date'}"/>
                                                </span>
                                                <span class="" t-else="">NO DEADLINE</span>
                                            </td>
                                            <td class="text-center py-3">
                                                <span class="badge py-2 px-3 rounded-pill fw-semibold" t-attf-class="badge-status-#{'done' if task.stage_id.fold else 'in-progress'}">
                                                    <t t-esc="task.stage_id.name"/>
                                                </span>
                                            </td>

                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </t>
    </template>
<template id="pro_client_portal_invoices_page" name="Portal Invoices">
    <t t-call="website.layout">
        <div class="bg-light min-vh-100 py-5" id="wrap">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="text-dark fw-bold m-0">My Invoices</h2>
                    <a href="/my_portal" class="btn btn-outline-secondary btn-sm rounded-pill py-1.5 px-3">
                        <i class="fa fa-arrow-left me-1"></i>Back to Dashboard
                    </a>
                </div>
                <div class="card shadow-sm border-0 rounded-3 overflow-hidden" t-if="invoices">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 custom-portal-table">
                            <thead class="table-dark">
                                <tr class="">
                                    <th class="ps-4 py-3">Invoice Number</th>
                                    <th class="py-3">Invoice Date</th>
                                    <th class="py-3">Due Date</th>
                                    <th class="py-3 text-end">Total Amount</th>
                                    <th class="py-3 text-center ps-4">Payment Status</th>
                                </tr>
                            </thead>
                            <tbody class="">
                                <t t-foreach="invoices" t-as="invoice">
                                    <tr class="">
                                        <td class="ps-4 py-3 fw-bold text-dark" t-esc="invoice.name if invoice.state != 'draft' else ('Draft')"/>
                                        <td class="text-muted py-3" t-esc="invoice.invoice_date" t-options='{"widget": "date"}'/>
                                        <td class="text-muted py-3" t-esc="invoice.invoice_date_due" t-options='{"widget" : "date"}'/>
                                        <td class="fw-bold text-dark py-3 text-end">
                                            <t t-esc="invoice.amount_total" t-options='{"widget" : "monetary", "display_currency": invoice.currency_id}'/>
                                        </td>
                                        <td class="text-center py-3 ps-4">
                                            <span class="rounded-pill fw-semibold py-2 px-3 badge"
                                            t-attf-attribute_name="badge-status-#{'paid' if invoice.payment_state == 'paid' else ('unpaid' if invoice.payment_state in ['not_paid', 'reserved'] else 'draft')}"
                                            >
                                                <t t-if="invoice.payment_state == 'paid'">Paid</t>
                                                <t t-elif="invoice.payment_state in ['not_paid', 'reserved']">Unpaid</t>
                                                <t t-else="">Draft / Other</t>
                                        </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="text-center shadow-sm rounded-3 py-5 mt-4 bg-white" t-else="">
                    <div class="text-muted mb-3 "><i class="fa fa-credit-card fa-4x"></i></div>
                    <h4 class="text-dark fw-bold">No Invoice Found</h4>
                    <p class="text-muted mb-0">No invoice have been billed to your account yet.</p>
                </div>
            </div>
        </div>
    </t>
</template>


</odoo>
