<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_header" inherit_id="website.layout" name="Portal Header">
        <xpath expr="//header" position="replace">
            <header class="bg-dark">
                <nav class="container navbar navbar-expand-lg navbar-dark shadow-sm">
                    <a href="/my_portal" class="navbar-brand text-primary fw-bold no-hover-effect">MY<span class="text-light">PRO</span><span class="text-primary">CLIENT</span><span class="text-light">PORTAL</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon text-light"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto" t-if="not env.user._is_public()">
                        <li class="nav-item">
                            <a href="/my_portal" class="nav-link fw-bold text-light opacity-75 hover-opacity-100 px-3"
                            t-attf-attribute_name="nav-link #{request.httprequest.path == '/my_portal' and 'active' or ''}">Home</a>
                        </li>
                        <li class="nav-item">
                            <a href="/my_portal/projects" class="nav-link text-light fw-bold px-3 opacity-75 hover-opacity-100"
                            t-attf-attribute_name="nav-link #{request.httprequest.path == '/my_portal/projects' and 'active' or ''}">Projects</a>
                        </li>
                        <li class="nav-item">
                            <a href="/my_portal/tasks" class="nav-link text-light fw-bold px-3 opacity-75 hover-opacity-100"
                            t-attf-attribute_name="nav-link #{request.httprequest.path == '/my_portal/tasks' and 'active' or ''}">Tasks</a>
                        </li>
                        <li class="nav-item">
                            <a href="/my_portal/invoices" class="nav-link text-light fw-bold px-3 opacity-75 hover-opacity-100"
                            t-attf-attribute_name="nav-link #{request.httprequest.path == '/my_portal/invoices' and 'active' or ''}">Invoices</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <t t-if="not env.user._is_public()">
                            <li class="nav-item dropdown">
                                <a href="#" class="nav-link dropdown-toggle text-light px-3 d-flex fw-bold align-items-center" data-bs-toggle="dropdown" id="userMenu" role="button" aria-expanded="false">
                                    <i class="fa fa-user-circle-o fa-lg me-2"></i>
                                    <t t-esc="env.user.name"/>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2 mt-2" aria-labelledby="userMenu">
                                    <li class="">
                                        <a href="/my/account" class="dropdown-item py-2 px-3 d-flex align-items-center">
                                            <i class="fa fa-sliders me-2"></i>My Account
                                        </a>
                                    </li>
                                    <li class=""><hr class="dropdown-divider my-1"/></li>
                                    <li class="">
                                        <a href="/web/session/logout?redirect=/" class="dropdown-item py-2 px-3 text-danger d-flex align-items-center">
                                            <i class="fa fa-sign-out me-2"></i>Logout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </t>
                        <t t-else="">
                            <li class="nav-item">
                                <a href="/web/login" class="btn btn-outline-primary text-light border-light fw-bold px-4 rounded-pill">Sign In</a>
                            </li>
                        </t>
                    </ul>
                </div>
                </nav>
            </header>
        </xpath>
    </template>

</odoo>
