<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_restaurant_menu_item_tree" model="ir.ui.view">
        <field name="name">restaurant.menu.item.tree</field>
        <field name="model">restaurant.menu.item</field>
        <field name="arch" type="xml">
            <tree string="Menu Items">
                <field name="name" />
                <field name="category" />
                <field name="price" />
                <field name="available" />
            </tree>
        </field>
    </record>

    <record id="view_restaurant_menu_item_kanban" model="ir.ui.view">
        <field name="name">restaurant.menu.item.kanban</field>
        <field name="model">restaurant.menu.item</field>
        <field name="arch" type="xml">
            <kanban class="o_restaurant_dashboard">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click oe_kanban_card restaurant_order_card">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name" /></strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>Price: <field name="price"/></div>
                                <div>Category: <field name="category"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_restaurant_menu_item_form" model="ir.ui.view">
        <field name="name">restaurant.menu.item.form</field>
        <field name="model">restaurant.menu.item</field>
        <field name="arch" type="xml">
            <form string="Menu Items">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="category" />
                        <field name="price" />
                        <field name="available" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_restaurant_menu_item" model="ir.actions.act_window">
        <field name="name">Menu Items</field>
        <field name="res_model">restaurant.menu.item</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <menuitem
        id="menu_restaurant_menu_items"
        name="Menu Items"
        action="action_restaurant_menu_item"
        parent="menu_resturent_root"
        sequence="15"/>

</odoo>
