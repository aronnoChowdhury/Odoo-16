<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sequence_resaurant_order" model="ir.sequence">
        <field name="name">Restaurant Sequence Order</field>
        <field name="code">restaurant.order</field>
        <field name="prefix">ORD</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="view_restaurant_order_tree" model="ir.ui.view">
        <field name="name">restaurant.order.view</field>
        <field name="model">restaurant.order</field>
        <field name="arch" type="xml">
            <tree string="Restaurant Orders">
                <field name="name"/>
                <field name="table_id"/>
                <field name="customer_name"/>
                <field name="amount_total"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'preparing'" decoration-success="state == 'ready' or state == 'completed'" decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_restaurant_order_kanban" model="ir.ui.view">
        <field name="name">restaurant.order.view.kanban</field>
        <field name="model">restaurant.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by = "state" class="o_kanban_small_column o_restaurant_dashboard">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click oe_kanban_card restaurant_order_card">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                                <field name="state" widget="kanban_label_selection" options="{'classes': {'draft': 'info', 'preparing': 'warning', 'ready': 'success', 'completed': 'success', 'cancelled': 'danger'}}"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class=""><strong class="">Table: </strong><field name="table_id" /></div>
                                <div class=""><strong class="">Customer: </strong><field name="customer_name"></field></div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <strong class="">Total: $ <field name="amount_total" /></strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_restaurant_order_form" model="ir.ui.view">
        <field name="name">restaurant.order.view</field>
        <field name="model">restaurant.order</field>
        <field name="arch" type="xml">
            <form string="Restaurant Order">
                <header class="">
                    <field name="state" widget="statusbar" statusbar_visible="draft,preparing,ready,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1 class=""><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="table_id"/>
                            <field name="customer_name"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="" string="Order Items">
                            <field name="order_line_ids">
                                <tree editable="bottom">
                                    <field name="menu_item_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="amount_total" class="oe_subtotal_footer_separator"></field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_restaurant_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">restaurant.order</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <menuitem
        id="menu_restaurant_order"
        name="Orders"
        action="action_restaurant_order"
        parent="menu_resturent_root"
        sequence="10"/>

</odoo>
